\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 13: Enable Passwordless SSH\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 macOS requires SSH for Hadoop daemons.\
Generate a key:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
ssh-keygen -t rsa\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Press 
\f0\b \strokec2 Enter
\f1\b0 \strokec2  for every prompt.\
Then:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
cat ~/.ssh/id_rsa.pub >> ~/.ssh/authorized_keys\
\
chmod 600 ~/.ssh/authorized_keys\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Verify:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
ssh localhost\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 The first time, type:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
yes\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Then:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
exit\
\
