\f0\b\fs48 \cf0 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Step 1: Verify Java Installation\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Check your Java version:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
java -version\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 You should see Java 11, 17, or 21.\
Now find 
\f2\fs26 JAVA_HOME
\f1\fs24 :\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
/usr/libexec/java_home\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Example output:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Remember this path.\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 2: Download Hadoop\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Download the latest stable Hadoop 3.x release from Apache.\
Example:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
cd ~/Downloads\
\
curl -O https://downloads.apache.org/hadoop/common/hadoop-3.4.1/hadoop-3.4.1.tar.gz\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Or download it from the Apache website using your browser.\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 3: Extract Hadoop\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 \
cd ~\
\
tar -xzf ~/Downloads/hadoop-3.4.1.tar.gz\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Rename it:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
mv hadoop-3.4.1 hadoop\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Now Hadoop will be located at:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
~/hadoop\
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 4: Configure Environment Variables\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Edit your shell profile.\
If you're using zsh (default on macOS):\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
nano ~/.zshrc\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Add:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
export JAVA_HOME=$(/usr/libexec/java_home)\
\
export HADOOP_HOME=$HOME/hadoop\
\
export PATH=$PATH:$HADOOP_HOME/bin\
\
export PATH=$PATH:$HADOOP_HOME/sbin\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Save:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
Ctrl + O\
Enter\
Ctrl + X\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Reload:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
source ~/.zshrc\
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 5: Verify Hadoop\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 \
hadoop version\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Expected:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
Hadoop 3.x.x\
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 6: Configure JAVA_HOME\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Edit:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
nano $HADOOP_HOME/etc/hadoop/hadoop-env.sh\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Find:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
export JAVA_HOME=\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Replace with\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
export JAVA_HOME=$(/usr/libexec/java_home)\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 or paste the complete path.\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 7: Create Hadoop Data Directories\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 \
mkdir ~/hadoopdata\
mkdir ~/hadoopdata/hdfs\
mkdir ~/hadoopdata/hdfs/namenode\
mkdir ~/hadoopdata/hdfs/datanode\
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 8: Configure 
\f3\fs52 core-site.xml
\f0\fs48 \
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Edit:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
nano $HADOOP_HOME/etc/hadoop/core-site.xml\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Replace with:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
<configuration>\
\
<property>\
    <name>fs.defaultFS</name>\
    <value>hdfs://localhost:9000</value>\
</property>\
\
</configuration>\
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 9: Configure 
\f3\fs52 hdfs-site.xml
\f0\fs48 \
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 \
nano $HADOOP_HOME/etc/hadoop/hdfs-site.xml\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Replace with:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
<configuration>\
\
<property>\
    <name>dfs.replication</name>\
    <value>1</value>\
</property>\
\
<property>\
    <name>dfs.namenode.name.dir</name>\
    <value>file:///Users/YOUR_USERNAME/hadoopdata/hdfs/namenode</value>\
</property>\
\
<property>\
    <name>dfs.datanode.data.dir</name>\
    <value>file:///Users/YOUR_USERNAME/hadoopdata/hdfs/datanode</value>\
</property>\
\
</configuration>\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Replace 
\f2\fs26 YOUR_USERNAME
\f1\fs24  with your macOS username.\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 10: Configure 
\f3\fs52 mapred-site.xml
\f0\fs48 \
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Copy the template:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
cp \\\
$HADOOP_HOME/etc/hadoop/mapred-site.xml.template \\\
$HADOOP_HOME/etc/hadoop/mapred-site.xml\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Edit:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
nano $HADOOP_HOME/etc/hadoop/mapred-site.xml\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Paste:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
<configuration>\
\
<property>\
    <name>mapreduce.framework.name</name>\
    <value>yarn</value>\
</property>\
\
</configuration>\
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf3 \strokec3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 \strokec2 Step 11: Configure 
\f3\fs52 yarn-site.xml
